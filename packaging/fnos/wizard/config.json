{
  "steps": [
    {
      "id": "output_dir",
      "type": "folder_picker",
      "title": "选择归档目录",
      "description": "请选择 PDF 文件的保存位置。飞牛 NAS 存储路径严禁硬编码,由你在此自由选择共享目录。",
      "key": "XHS_OUTPUT_DIR",
      "required": true,
      "default": "/vol1/@appdata/xhs-study-pdf/output",
      "writable": true
    },
    {
      "id": "port",
      "type": "number",
      "title": "Web 服务端口",
      "description": "局域网访问端口,默认 5088。",
      "key": "XHS_WEB_PORT",
      "required": true,
      "default": 5088,
      "min": 1024,
      "max": 65535
    }
  ]
}
