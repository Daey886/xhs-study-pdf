{
  "app": {
    "name": "小红书资料转PDF",
    "package": "com.xhs-study-pdf",
    "version": "1.0.0",
    "summary": "小红书试卷/课件智能去杂转标准 A4 PDF 工具",
    "description": "家庭自用版:手机扫码一次持久化本地 cookie.json,单机/局域网使用,无中央 Cookie 池。支持桌面 GUI、CLI 与 Web 界面。",
    "category": "工具",
    "homepage": "https://github.com/Daey886/xhs-study-pdf",
    "author": "xhs-study-pdf",
    "license": "GPL-3.0",
    "icon": "config/resource/icon.png",
    "arch": ["amd64", "arm64"],
    "privileges": {
      "network": true,
      "storage": true
    }
  },
  "web": {
    "type": "docker",
    "port": 5088,
    "protocol": "http",
    "path": "/"
  },
  "control": {
    "start": "cmd/main start",
    "stop": "cmd/main stop",
    "status": "cmd/main status"
  },
  "wizard": {
    "enabled": true,
    "config": "wizard/config.json"
  }
}
