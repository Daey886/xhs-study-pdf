#!/usr/bin/env bash
# ============================================================
#  飞牛 NAS (fnOS) 应用控制脚本: start / stop / status
#  严禁硬编码存储路径 —— 归档目录由安装向导 (wizard) 写入环境变量
# ============================================================
set -euo pipefail

# fnOS 注入的应用数据目录 (通常在 /vol1/@appdata/<app>)
APP_DATA_DIR="${APP_DATA_DIR:-/vol1/@appdata/xhs-study-pdf}"
CONF_FILE="$APP_DATA_DIR/config.env"
PID_FILE="$APP_DATA_DIR/app.pid"
LOG_FILE="$APP_DATA_DIR/app.log"

# 归档目录:由向导写入 config.env 的 XHS_OUTPUT_DIR 决定,默认回退到 APP_DATA_DIR/output
mkdir -p "$APP_DATA_DIR"
if [[ -f "$CONF_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONF_FILE"
fi
XHS_OUTPUT_DIR="${XHS_OUTPUT_DIR:-$APP_DATA_DIR/output}"
mkdir -p "$XHS_OUTPUT_DIR"

start() {
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "already running (pid $(cat "$PID_FILE"))"
        exit 0
    fi
    export RUN_MODE="lan"
    export XHS_OUTPUT_DIR
    cd "$(dirname "$0")/../.."
    nohup python3 web_frontend/server.py \
        --mode lan \
        --output-dir "$XHS_OUTPUT_DIR" \
        --host 0.0.0.0 \
        --port "${XHS_WEB_PORT:-5088}" \
        >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"
    echo "started (pid $(cat "$PID_FILE"))"
}

stop() {
    if [[ -f "$PID_FILE" ]]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
        rm -f "$PID_FILE"
        echo "stopped"
    else
        echo "not running"
    fi
}

status() {
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "running (pid $(cat "$PID_FILE"))"
    else
        echo "stopped"
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|status}" ; exit 1 ;;
esac
